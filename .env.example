# ═════════════════════════════════════════════════════════════════════════
# Variables d'Environnement - Secure API Gateway
# ═════════════════════════════════════════════════════════════════════════
# IMPORTANT: Copier ce fichier en .env et remplir avec vos vraies valeurs
# NEVER commit .env en contrôle de version!

# ─────────────────────────────────────────────────────────────────────────
# PostgreSQL Configuration
# ─────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password-here-min-16-chars
POSTGRES_DB=api_gateway
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/api_gateway

# ─────────────────────────────────────────────────────────────────────────
# Flask Configuration
# ─────────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_SECRET_KEY=your-super-secret-flask-key-min-32-chars-random
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars-random-different

# ─────────────────────────────────────────────────────────────────────────
# Security Settings
# ─────────────────────────────────────────────────────────────────────────
# Débugage (JAMAIS en production)
FLASK_DEBUG=False

# HTTPS/TLS
ENABLE_HTTPS=False
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True

# ─────────────────────────────────────────────────────────────────────────
# API Gateway (Kong)
# ─────────────────────────────────────────────────────────────────────────
KONG_ADMIN_API=http://kong:8001
KONG_PROXY_ACCESS_LOG=/dev/stdout
KONG_PROXY_ERROR_LOG=/dev/stderr

# ─────────────────────────────────────────────────────────────────────────
# Logging & Monitoring
# ─────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_AUDIT_LOG=True
SIEM_ENDPOINT=http://elasticsearch:9200

# ─────────────────────────────────────────────────────────────────────────
# Production Checklist
# ─────────────────────────────────────────────────────────────────────────
# ✅ Générer secrets forts: python -c "import secrets; print(secrets.token_hex(32))"
# ✅ Ajouter .env à .gitignore
# ✅ Utiliser Vault ou AWS Secrets Manager
# ✅ Rotation des secrets tous les 90 jours
# ✅ Différents secrets par environnement (dev/staging/prod)
