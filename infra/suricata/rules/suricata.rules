# Suricata Rules — Secure API Gateway
# Fixed for Docker Desktop Windows: inspects HTTP body (JSON payloads)

# ============================================================================
# SQL Injection — body inspection (JSON payloads)
# ============================================================================
alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - UNION SELECT"; flow:established,to_server; http.request_body; pcre:"/union\s+(?:all\s+)?select/i"; classtype:web-application-attack; sid:1001; rev:3;)
alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - OR tautology bypass"; flow:established,to_server; http.request_body; pcre:"/(?:'|%27|\"|%22)?\s+or\s+(?:'?\d+'?\s*=\s*'?\d+'?|'.{0,20}'\s*=\s*'.{0,20}')/i"; classtype:web-application-attack; sid:1002; rev:3;)
alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - DROP TABLE"; flow:established,to_server; http.request_body; pcre:"/drop\s+table/i"; classtype:web-application-attack; sid:1003; rev:3;)
alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - comment bypass"; flow:established,to_server; http.request_body; content:"--"; classtype:web-application-attack; sid:1004; rev:3;)
alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - OR quote bypass"; flow:established,to_server; http.request_body; content:"' OR '"; nocase; classtype:web-application-attack; sid:1005; rev:3;)
alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - time based SLEEP"; flow:established,to_server; http.request_body; pcre:"/sleep\s*\(/i"; classtype:web-application-attack; sid:1006; rev:1;)

# ============================================================================
# XSS — body inspection
# ============================================================================
alert http any any -> any $HTTP_PORTS (msg:"XSS - Script tag"; flow:established,to_server; http.request_body; content:"<script"; nocase; classtype:web-application-attack; sid:2001; rev:3;)
alert http any any -> any $HTTP_PORTS (msg:"XSS - JavaScript URI"; flow:established,to_server; http.request_body; content:"javascript:"; nocase; classtype:web-application-attack; sid:2002; rev:3;)
alert http any any -> any $HTTP_PORTS (msg:"XSS - SVG onload"; flow:established,to_server; http.request_body; content:"<svg"; nocase; content:"onload"; nocase; distance:0; within:50; classtype:web-application-attack; sid:2003; rev:3;)
alert http any any -> any $HTTP_PORTS (msg:"XSS - IMG onerror"; flow:established,to_server; http.request_body; content:"<img"; nocase; content:"onerror"; nocase; distance:0; within:50; classtype:web-application-attack; sid:2004; rev:3;)
alert http any any -> any $HTTP_PORTS (msg:"XSS - onerror handler"; flow:established,to_server; http.request_body; content:"onerror"; nocase; classtype:web-application-attack; sid:2005; rev:3;)

# ============================================================================
# DoS / Brute Force
# ============================================================================
alert http any any -> any $HTTP_PORTS (msg:"HTTP - Excessive requests from single IP"; flow:established,to_server; threshold:type both,track by_src,count 100,seconds 60; sid:3001; rev:2;)
alert http any any -> any $HTTP_PORTS (msg:"HTTP - Slowloris potential attack"; flow:established,to_server; content:"Host|3a|"; http_header; threshold:type both,track by_src,count 30,seconds 60; sid:3002; rev:3;)
alert http any any -> any $HTTP_PORTS (msg:"Brute Force - Multiple failed logins"; flow:established,to_server; http.uri; content:"/users/login"; http.method; content:"POST"; threshold:type both,track by_src,count 10,seconds 60; sid:4001; rev:2;)

# ============================================================================
# Reconnaissance
# ============================================================================
alert http any any -> any $HTTP_PORTS (msg:"Scan - admin endpoint"; flow:established,to_server; http.uri; content:"/admin"; sid:5001; rev:2;)
alert http any any -> any $HTTP_PORTS (msg:"Scan - env file access"; flow:established,to_server; http.uri; content:"/.env"; sid:5002; rev:2;)
alert http any any -> any $HTTP_PORTS (msg:"Suspicious User-Agent - sqlmap"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; sid:6001; rev:2;)
alert http any any -> any $HTTP_PORTS (msg:"Suspicious User-Agent - nikto"; flow:established,to_server; http.user_agent; content:"nikto"; nocase; sid:6002; rev:2;)

# ============================================================================
# Payment API
# ============================================================================
alert http any any -> any $HTTP_PORTS (msg:"Payment API - Suspicious large amount"; flow:established,to_server; http.uri; content:"/payments"; http.method; content:"POST"; http.request_body; content:"amount"; nocase; sid:7001; rev:2;)
